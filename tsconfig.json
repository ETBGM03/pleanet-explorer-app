{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@constants": ["./constants/index.ts"],
      "@components": ["./components/index.ts"],
      "@types": ["./types/index.ts"],
      "@adapters": ["./adapters/index.ts"],
      "@libs": ["./lib/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
